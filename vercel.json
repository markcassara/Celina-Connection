{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/route.mjs": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/route" },
    { "source": "/api/(.*)", "destination": "/api/route" },
    { "source": "/sitemap.xml", "destination": "/api/route" },
    { "source": "/server.cjs", "destination": "/api/not-found" },
    { "source": "/server.cjs.map", "destination": "/api/not-found" },
    { "source": "/images/mobile_service_van_(.*)", "destination": "/api/not-found" },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/home"
    },
    {
      "source": "/directory",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/directory"
    },
    {
      "source": "/directory/:category",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/category/:category"
    },
    {
      "source": "/events",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/events"
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/pricing"
    },
    {
      "source": "/launch",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/launch"
    },
    {
      "source": "/legacyhillspetition",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/page/legacyhillspetition"
    },
    {
      "source": "/business/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|WhatsApp|TelegramBot|Pinterestbot|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/share/business/:slug"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
